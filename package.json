{
  "name": "website-rebuild",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "set NODE_OPTIONS=--no-warnings && next dev",
    "dev:turbo": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy:cloudflare": "wrangler deploy",
    "preview:cloudflare": "opennextjs-cloudflare build && wrangler dev"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "@opennextjs/cloudflare": "1.20.17",
    "wrangler": "4.164.0",
    "rclone.js": "0.6.6"
  }
}
